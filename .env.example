# Copy to .env, chmod 600, and replace every required value.
# Do not quote values: Compose raw env_file preserves quotes and dollar signs.
PMEM_ACCOUNT=me
PMEM_PASSWORD_HASH=
PMEM_SESSION_KEY=
# Public deployments require HTTPS. Loopback HTTP is development only.
PMEM_ORIGIN=http://localhost:3000
PMEM_STORAGE=local
PMEM_DATA_DIR=.pmem/data
PMEM_STATE_DIR=.pmem/state
HOST=127.0.0.1
PORT=3000
# Only required for PMEM_STORAGE=oss. Use a private, never-versioned bucket.
PMEM_OSS_REGION=oss-cn-hangzhou
PMEM_OSS_BUCKET=
PMEM_OSS_PREFIX=pmem/
PMEM_OSS_ACCESS_KEY_ID=
PMEM_OSS_ACCESS_KEY_SECRET=
